{
  "name": "pressroom-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "graphql": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7",
    "urql": "^4",
    "zod": "^3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5",
    "@graphql-codegen/client-preset": "^4",
    "@graphql-typed-document-node/core": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "~5.8",
    "vite": "^6",
    "vitest": "^3"
  }
}
