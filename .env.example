# Copy to .env for docker compose, or export in your shell for `make dev-*`.
# Every key is optional locally: without them agents run on the sandbox model.

DATABASE_URL=postgres://pressroom:pressroom@localhost:5432/pressroom?sslmode=disable

# live | sandbox | auto (real provider when its key is set, sandbox otherwise)
PRESSROOM_MODEL_MODE=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Any OpenAI-compatible server for open-weights models. Leave empty unless one
# is running, e.g. Ollama at http://localhost:11434/v1 (from inside Docker use
# http://host.docker.internal:11434/v1).
OPEN_SOURCE_BASE_URL=

# Measurement
PRESSROOM_HOURLY_RATE_USD=32
PRESSROOM_EVAL_WINDOW_DAYS=30

# Integrations
SLACK_WEBHOOK_URL=
IMAGE_STUDIO_URL=
IMAGE_STUDIO_TOKEN=

# API access. In production set a token, or PRESSROOM_TRUST_IAP=true behind IAP.
PRESSROOM_API_TOKEN=
PRESSROOM_CORS_ORIGINS=http://localhost:5173
